        "spec": {
          "id": 10,
          "title": "Top 10 Datastores by Usage",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH ranked_datastores AS (\r\n    SELECT datastore_data, percent_use, time,\r\n           ROW_NUMBER() OVER (PARTITION BY datastore_data ORDER BY time DESC) as rn\r\n    FROM datastore_usage\r\n    WHERE $__timeFilter(time)\r\n)\r\nSELECT datastore_data, percent_use\r\nFROM ranked_datastores\r\nWHERE rn = 1\r\nORDER BY percent_use DESC\r\nLIMIT 10;",
                        "sql": {
