                        "rawSql": "SELECT COUNT(*) AS created\r\nFROM (\r\n    SELECT\r\n        id,\r\n        MAX(created_at) AS first_seen,\r\n        (ARRAY_AGG(is_deleted ORDER BY created_at DESC))[1] AS is_deleted\r\n    FROM vm_lifecycle\r\n    WHERE datacenter = '$dc1'\r\n    GROUP BY id\r\n) t\r\nWHERE is_deleted = false\r\n  AND first_seen >= EXTRACT(EPOCH FROM (NOW() - INTERVAL '30 days')) * 1000;",
